#!/bin/bash
# Claude Code with local LLM via LiteLLM proxy

PROXY_URL="http://localhost:4000"
CONFIG_FILE="$HOME/.claude/litellm_config.yaml"
FORWARD_PORT=18080

# --- Network config ---
LAN_IP="${LLAMA_LAN_IP:-192.168.68.67}"
TS_IP="${LLAMA_TS_IP:-100.89.99.41}"
LLAMA_PORT="${LLAMA_PORT:-8080}"
TS_SOCKS5="${TAILSCALE_SOCKS5:-localhost:1055}"

# --- Auto-detect LAN หรือ Tailscale ---
echo "กำลังตรวจสอบ network..."
if curl -s --max-time 2 "http://$LAN_IP:$LLAMA_PORT/health" > /dev/null 2>&1; then
    echo "Network: LAN ($LAN_IP)"
    LLAMA_API_BASE="http://$LAN_IP:$LLAMA_PORT/v1"
    EFFECTIVE_API_BASE="$LLAMA_API_BASE"
    CURL_OPTS=""
    USE_TAILSCALE=0
else
    echo "Network: Tailscale ($TS_IP)"
    LLAMA_API_BASE="http://$TS_IP:$LLAMA_PORT/v1"
    CURL_OPTS="--proxy socks5h://$TS_SOCKS5"
    USE_TAILSCALE=1

    # สร้าง local port forward ผ่าน Tailscale สำหรับ LiteLLM
    pkill -f "tailscale-forward $FORWARD_PORT" 2>/dev/null
    fuser -k ${FORWARD_PORT}/tcp 2>/dev/null
    sleep 1
    echo "Forwarding: $TS_IP:$LLAMA_PORT → localhost:$FORWARD_PORT"
    tailscale-forward $FORWARD_PORT $TS_IP $LLAMA_PORT &>/tmp/ts-forward.log &
    sleep 2
    EFFECTIVE_API_BASE="http://localhost:$FORWARD_PORT/v1"
fi

# --- ดึงชื่อ model ---
MODEL_NAME=$(curl -s $CURL_OPTS "$LLAMA_API_BASE/models" | python3 -c "
import sys, json, re
data = json.load(sys.stdin)
models = data.get('data') or data.get('models') or []
full = models[0]['id'] if models else 'local-model'
name = full.replace('.gguf', '')
match = re.match(r'^([a-zA-Z]+-\d+)', name)
short = match.group(1) if match else name.split('-')[0]
print(f'{short} (local)')
" 2>/dev/null)

if [ -z "$MODEL_NAME" ]; then
    echo "Error: ไม่สามารถดึงชื่อ model จาก $LLAMA_API_BASE"
    exit 1
fi

echo "Model: $MODEL_NAME"

# --- สร้าง LiteLLM config ---
cat > "$CONFIG_FILE" <<EOF
model_list:
  - model_name: $MODEL_NAME
    litellm_params:
      model: openai/$MODEL_NAME
      api_base: $EFFECTIVE_API_BASE
      api_key: dummy
      supports_function_calling: true

litellm_settings:
  drop_params: true
  use_chat_completions_url_for_anthropic_messages: true
  callbacks: ["/root/litellm_hooks/system_prompt_hook.proxy_handler_instance"]
EOF

# --- Start LiteLLM proxy ---
LITELLM_PROXY_DIR=$(python3 -c "import litellm.proxy, os; print(os.path.dirname(litellm.proxy.__file__))")
pkill -f "proxy_cli.py.*4000" 2>/dev/null
sleep 1
echo "Starting LiteLLM proxy..."
setsid python3 "$LITELLM_PROXY_DIR/proxy_cli.py" --config "$CONFIG_FILE" --port 4000 >/tmp/litellm.log 2>&1 &
sleep 6

ANTHROPIC_BASE_URL="$PROXY_URL" \
ANTHROPIC_API_KEY="dummy" \
claude --model "$MODEL_NAME" "$@"
