#!/bin/bash
# Claude Code with local LLM via LiteLLM proxy

PROXY_URL="http://localhost:4000"
CONFIG_FILE="$HOME/.claude/litellm_config.yaml"

# ตรวจสอบ LLAMA_API_BASE
if [ -z "$LLAMA_API_BASE" ]; then
    echo "Error: กรุณาตั้งค่า LLAMA_API_BASE ก่อน"
    echo "ตัวอย่าง: export LLAMA_API_BASE=http://192.168.1.100:8080/v1"
    exit 1
fi

# ดึงชื่อ model จาก llama.cpp server
MODEL_NAME=$(curl -s "$LLAMA_API_BASE/models" | python3 -c "
import sys, json, re
data = json.load(sys.stdin)
models = data.get('data') or data.get('models') or []
full = models[0]['id'] if models else 'local-model'
# ย่อชื่อ เช่น gemma-4-26B-A4B-it-Q6_K.gguf → gemma-4 (local)
name = full.replace('.gguf', '')
match = re.match(r'^([a-zA-Z]+-\d+)', name)
short = match.group(1) if match else name.split('-')[0]
print(f'{short} (local)')
" 2>/dev/null)

if [ -z "$MODEL_NAME" ]; then
    echo "Error: ไม่สามารถดึงชื่อ model จาก $LLAMA_API_BASE"
    exit 1
fi

echo "Model: $MODEL_NAME"

# สร้าง config พร้อมชื่อ model จริง
cat > "$CONFIG_FILE" <<EOF
model_list:
  - model_name: $MODEL_NAME
    litellm_params:
      model: openai/$MODEL_NAME
      api_base: $LLAMA_API_BASE
      api_key: dummy

litellm_settings:
  drop_params: true
EOF

# Start LiteLLM proxy ถ้ายังไม่ได้รัน
if ! curl -s "$PROXY_URL/health" > /dev/null 2>&1; then
    echo "Starting LiteLLM proxy..."
    litellm --config "$CONFIG_FILE" --port 4000 &> /tmp/litellm.log &
    sleep 4
else
    # restart เพื่อโหลด config ใหม่
    pkill -f "litellm.*4000" 2>/dev/null
    sleep 1
    litellm --config "$CONFIG_FILE" --port 4000 &> /tmp/litellm.log &
    sleep 4
fi

ANTHROPIC_BASE_URL="$PROXY_URL" \
ANTHROPIC_API_KEY="dummy" \
claude --model "$MODEL_NAME" "$@"
