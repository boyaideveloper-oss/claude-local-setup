#!/usr/bin/env python3
"""Forward local port to Tailscale host via SOCKS5 proxy."""
import socket
import threading
import sys

SOCKS5_HOST = "127.0.0.1"
SOCKS5_PORT = 1055


def socks5_connect(sock, dst_host, dst_port):
    """Perform SOCKS5 handshake."""
    sock.sendall(b"\x05\x01\x00")  # SOCKS5, 1 method, no auth
    if sock.recv(2) != b"\x05\x00":
        raise Exception("SOCKS5 handshake failed")
    host = dst_host.encode()
    sock.sendall(b"\x05\x01\x00\x03" + bytes([len(host)]) + host + dst_port.to_bytes(2, "big"))
    resp = sock.recv(10)
    if resp[1] != 0:
        raise Exception(f"SOCKS5 connect failed: {resp[1]}")


def handle(client, dst_host, dst_port):
    proxy = socket.create_connection((SOCKS5_HOST, SOCKS5_PORT))
    try:
        socks5_connect(proxy, dst_host, dst_port)
    except Exception as e:
        print(f"Error: {e}")
        client.close()
        proxy.close()
        return

    def pipe(src, dst):
        try:
            while chunk := src.recv(4096):
                dst.sendall(chunk)
        except:
            pass
        finally:
            src.close()
            dst.close()

    threading.Thread(target=pipe, args=(client, proxy), daemon=True).start()
    threading.Thread(target=pipe, args=(proxy, client), daemon=True).start()


def main():
    if len(sys.argv) != 4:
        print("Usage: tailscale-forward <local_port> <dst_host> <dst_port>")
        sys.exit(1)

    local_port = int(sys.argv[1])
    dst_host = sys.argv[2]
    dst_port = int(sys.argv[3])

    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", local_port))
    server.listen(50)
    print(f"Forwarding localhost:{local_port} → {dst_host}:{dst_port} via Tailscale")

    while True:
        client, _ = server.accept()
        threading.Thread(target=handle, args=(client, dst_host, dst_port), daemon=True).start()


if __name__ == "__main__":
    main()
